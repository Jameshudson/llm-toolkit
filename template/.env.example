# llm-toolkit — per-repo settings. Never commit .env.
#
# Keys are user-level: if one is missing, `llm` prompts for it once and saves it
# to ~/.llm-toolkit/settings.json, reused across every repo. Set a key here only
# to override it for this repo. The environment (your shell, CI) beats this file.
# `llm` refuses to start if the configured provider's key is missing — bypass
# with LLM_SKIP_KEY_CHECK=1.

# --- Keys (usually global — override here only if this repo differs) ----------
# OPENROUTER_MANAGEMENT_KEY=   # admin key; enables spend tracking (one scoped key per project)
# OPENROUTER_API_KEY=          # fallback inference key
# DEEPSEEK_API_KEY=            # for direct DeepSeek calls

# --- Session behaviour --------------------------------------------------------
# USD credit limit applied to the managed OpenRouter key (default $5). Leave
# empty for no limit. Changing it re-syncs the existing key's limit.
SESSION_LIMIT=5

# Set to 0 to disable the managed key and use OPENROUTER_API_KEY directly.
LLM_SESSION_KEYS=1

# Default model, passed to the harness. Override per-run with MODEL=...
# MODEL=openrouter/deepseek/deepseek-v4.1-flash

# --- Images -------------------------------------------------------------------
# Registry prefix before "llm-toolkit" (trailing slash). Empty uses local image
# tags. Set here or in the environment.
# LLM_REGISTRY=ghcr.io/jameshudson/
