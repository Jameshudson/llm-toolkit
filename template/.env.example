# llm-toolkit — copy to .env and fill in. Never commit .env.
#
# bin/llm sources this file automatically (if present) before each session.

# --- OpenRouter ---------------------------------------------------------------
# A *management* key (https://openrouter.ai/settings/management-keys). Used only
# by `bin/or-key` and `bin/llm` to mint/read/delete API keys. It cannot make
# completion calls. Required for per-session spend tracking.
OPENROUTER_MANAGEMENT_KEY=

# Fallback inference key, used when no management key is set (no per-session
# spend attribution in that case). Pi/opencode read this as OPENROUTER_API_KEY.
OPENROUTER_API_KEY=

# --- DeepSeek -----------------------------------------------------------------
# DeepSeek has no key-management API, so keys must be created in their web UI.
# Injected as-is; spend is not attributed per session for direct DeepSeek calls.
DEEPSEEK_API_KEY=

# --- Session behaviour --------------------------------------------------------
# Optional USD credit limit applied to each per-session OpenRouter key.
# Leave empty for no limit.
SESSION_LIMIT=

# Set to 0 to disable per-session key minting and use OPENROUTER_API_KEY directly.
LLM_SESSION_KEYS=1

# Default model, passed to the harness. Override per-run with MODEL=...
# MODEL=openrouter/deepseek/deepseek-v4-flash

# --- Images -------------------------------------------------------------------
# Registry prefix before "llm-toolkit" (trailing slash). Empty uses local image
# tags. Set here or in the environment.
# LLM_REGISTRY=ghcr.io/jameshudson/
