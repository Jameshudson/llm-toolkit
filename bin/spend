#!/usr/bin/env python3
"""spend — report on recorded harness sessions.

Reads spend/sessions.jsonl (written by bin/llm) and prints summaries, lists
recent sessions, or exports CSV. Stdlib only.

Usage:
  spend                 summary: totals, by harness, by model, by day
  spend list [-n N]     most recent N sessions (default 20)
  spend csv [PATH]      write CSV to PATH (default spend/sessions.csv)
  spend jsonl           print the raw JSONL
"""
from __future__ import annotations

import csv
import json
import os
import subprocess
import sys
from collections import defaultdict

TOOLKIT_DIR = os.environ.get("LLM_TOOLKIT_DIR") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__)))


def _git(args, cwd):
    try:
        out = subprocess.run(["git", *args], cwd=cwd,
                             capture_output=True, text=True)
        return out.stdout.strip()
    except Exception:
        return ""


def resolve_state_dir():
    env = os.environ.get("LLM_STATE_DIR")
    if env:
        return env
    repo = (_git(["rev-parse", "--show-toplevel"], os.getcwd())
            or _git(["rev-parse", "--show-superproject-working-tree"], TOOLKIT_DIR)
            or _git(["rev-parse", "--show-toplevel"], TOOLKIT_DIR))
    if not repo:
        repo = TOOLKIT_DIR
    return repo if repo == TOOLKIT_DIR else os.path.join(repo, ".llm-toolkit")


STATE_DIR = resolve_state_dir()
SPEND_FILE = os.path.join(STATE_DIR, "spend", "sessions.jsonl")

FIELDS = [
    "session_id", "harness", "model", "started_at", "ended_at", "duration_s",
    "exit_code", "cwd", "openrouter_key_hash", "openrouter_key_label",
    "cost_usd", "source",
]


def load():
    if not os.path.exists(SPEND_FILE):
        return []
    rows = []
    with open(SPEND_FILE, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return rows


def money(value):
    return f"${value:,.4f}"


def cmd_summary(rows):
    if not rows:
        print(f"no sessions recorded yet ({SPEND_FILE})")
        return
    priced = [r for r in rows if isinstance(r.get("cost_usd"), (int, float))]
    total = sum(r["cost_usd"] for r in priced)
    print(f"sessions: {len(rows)}   priced: {len(priced)}   total spend: {money(total)}")
    print()

    by = defaultdict(lambda: [0, 0.0])
    for r in rows:
        key = r.get("harness") or "?"
        by[key][0] += 1
        if isinstance(r.get("cost_usd"), (int, float)):
            by[key][1] += r["cost_usd"]
    print("by harness:")
    for key, (n, c) in sorted(by.items(), key=lambda kv: -kv[1][1]):
        print(f"  {key:<10} {n:>4} sessions  {money(c)}")
    print()

    by = defaultdict(lambda: [0, 0.0])
    for r in rows:
        key = r.get("model") or "(default)"
        by[key][0] += 1
        if isinstance(r.get("cost_usd"), (int, float)):
            by[key][1] += r["cost_usd"]
    print("by model:")
    for key, (n, c) in sorted(by.items(), key=lambda kv: -kv[1][1]):
        print(f"  {key:<38} {n:>4}  {money(c)}")
    print()

    by = defaultdict(float)
    for r in priced:
        day = (r.get("started_at") or "")[:10]
        by[day] += r["cost_usd"]
    if by:
        print("by day (last 14):")
        for day in sorted(by)[-14:]:
            print(f"  {day}  {money(by[day])}")


def cmd_list(rows, n):
    for r in rows[-n:][::-1]:
        cost = r.get("cost_usd")
        cost = money(cost) if isinstance(cost, (int, float)) else "—"
        print(f"{(r.get('started_at') or '')[:19]}  {r.get('harness',''):<9} "
              f"{cost:>11}  {r.get('model') or '(default)'}  {r.get('session_id','')}")


def cmd_csv(rows, path):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", newline="", encoding="utf-8") as fh:
        writer = csv.DictWriter(fh, fieldnames=FIELDS)
        writer.writeheader()
        for r in rows:
            writer.writerow({k: r.get(k, "") for k in FIELDS})
    print(f"wrote {len(rows)} rows to {path}")


def main(argv):
    rows = load()
    cmd = argv[0] if argv else "summary"
    if cmd == "summary":
        cmd_summary(rows)
    elif cmd == "list":
        n = 20
        if len(argv) >= 2 and argv[1] in ("-n", "--number"):
            n = int(argv[2])
        elif len(argv) >= 2:
            n = int(argv[1])
        cmd_list(rows, n)
    elif cmd == "csv":
        path = argv[1] if len(argv) >= 2 else os.path.join(STATE_DIR, "spend", "sessions.csv")
        cmd_csv(rows, path)
    elif cmd == "jsonl":
        with open(SPEND_FILE, encoding="utf-8") as fh:
            sys.stdout.write(fh.read())
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
