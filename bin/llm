#!/usr/bin/env bash
# llm — launch a coding harness inside the llm-toolkit container.
#
# Usage:
#   llm init                          # copy the toolkit's template/ into .llm-toolkit/
#   llm config                        # re-seed .llm-toolkit/config/ from the defaults
#   llm opencode [opencode args...]   # interactive opencode TUI
#   llm pi [pi args...]               # interactive pi
#   llm shell                         # bash inside the container
#   llm run --harness pi "prompt"     # convenience one-shot
#
# Per-repo customization (all optional, read from the state dir):
#   .env              keys and defaults (see .env.example)
#   config/           opencode/pi config overriding the toolkit defaults
#   image/Dockerfile  derived image FROM ${LLM_REGISTRY}llm-toolkit:${HARNESS}
#   image/mounts      extra docker mounts, one "host:container[:ro]" per line
#   image/env         extra env vars to forward to the container, one NAME per line
#   image/on-start.sh runs inside the container before the harness starts
#
# Images are pulled from LLM_REGISTRY when set, and built from this toolkit's
# Dockerfiles otherwise (or as a fallback).
#
# When OPENROUTER_MANAGEMENT_KEY is set (and LLM_SESSION_KEYS is not 0), one
# OpenRouter API key per project+harness is reused (cached in
# ~/.llm-toolkit/keys.json) and injected as OPENROUTER_API_KEY, capped by
# SESSION_LIMIT.
set -euo pipefail

# LLM_TOOLKIT_DIR lets an installed CLI point back at its data dir.
TOOLKIT_DIR="${LLM_TOOLKIT_DIR:-}"
[ -n "$TOOLKIT_DIR" ] || TOOLKIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve the project root: the git repo enclosing the current directory, else
# the toolkit's superproject (a submodule checkout), else the current directory
# itself — using the toolkit dir only when we are actually inside it.
REPO_ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO_ROOT" ] || REPO_ROOT="$(git -C "$TOOLKIT_DIR" rev-parse --show-superproject-working-tree 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  case "$PWD" in
    "$TOOLKIT_DIR"|"$TOOLKIT_DIR"/*) REPO_ROOT="$TOOLKIT_DIR" ;;
    *) REPO_ROOT="$PWD" ;;
  esac
fi

# State (.env, data/) lives in the repo. Only when the toolkit IS the repo
# (standalone use) does it fall back to the toolkit dir.
if [ "$REPO_ROOT" = "$TOOLKIT_DIR" ]; then
  STATE_DIR="${LLM_STATE_DIR:-$REPO_ROOT}"
else
  STATE_DIR="${LLM_STATE_DIR:-$REPO_ROOT/.llm-toolkit}"
fi

# Load .env. The environment wins: a variable already set (exported in your shell
# or CI) is not overridden. The repo's root .env wins over the legacy
# .llm-toolkit/.env.
load_env() {
  local f="$1" line key val
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|\#*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    printenv "$key" >/dev/null 2>&1 && continue
    val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    [ -n "$val" ] || continue
    export "$key=$val"
  done < "$f"
}
load_env "$REPO_ROOT/.env"
load_env "$STATE_DIR/.env"

# Global, user-level settings (secrets shared across repos). Lowest precedence:
# the environment and the repo's .env win over it.
GLOBAL_DIR="${LLM_HOME:-$HOME/.llm-toolkit}"
GLOBAL_SETTINGS="$GLOBAL_DIR/settings.json"

load_settings() {
  local f="$1" key val
  [ -f "$f" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  while IFS=$'\t' read -r key val; do
    case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    printenv "$key" >/dev/null 2>&1 && continue
    [ -n "$val" ] || continue
    export "$key=$val"
  done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$f" 2>/dev/null)
}
load_settings "$GLOBAL_SETTINGS"

# Store a value in the global settings file (0600), creating it if needed.
save_setting() {
  local key="$1" val="$2" tmp
  command -v jq >/dev/null 2>&1 || { echo "llm: jq not found; not saving $key" >&2; return 0; }
  mkdir -p "$GLOBAL_DIR"; chmod 700 "$GLOBAL_DIR" 2>/dev/null || true
  tmp="$GLOBAL_SETTINGS.tmp.$$"
  if [ -f "$GLOBAL_SETTINGS" ]; then
    jq --arg k "$key" --arg v "$val" '.[$k] = $v' "$GLOBAL_SETTINGS" > "$tmp"
  else
    jq -n --arg k "$key" --arg v "$val" '{($k): $v}' > "$tmp"
  fi
  mv "$tmp" "$GLOBAL_SETTINGS"
  chmod 600 "$GLOBAL_SETTINGS" 2>/dev/null || true
  echo "llm: saved $key to $GLOBAL_SETTINGS" >&2
}

# Prompt for a key (hidden input) and store it globally. No-op when not a TTY.
prompt_key() {
  local key="$1" label="$2" val=""
  [ -t 0 ] || return 1
  printf 'llm: %s is not set. Enter %s (hidden): ' "$key" "$label" >&2
  IFS= read -rs val || true
  printf '\n' >&2
  [ -n "$val" ] || return 1
  export "$key=$val"
  save_setting "$key" "$val"
  return 0
}

# The template `llm init` copies into a repo, and the fallback config.
TEMPLATE="$TOOLKIT_DIR/template"

# Harness config: the repo's own config/ if present, else the template's.
CONFIG_OPENCODE="$STATE_DIR/config/opencode"
[ -d "$CONFIG_OPENCODE" ] || CONFIG_OPENCODE="$TEMPLATE/config/opencode"
CONFIG_PI="$STATE_DIR/config/pi/agent"
[ -d "$CONFIG_PI" ] || CONFIG_PI="$TEMPLATE/config/pi/agent"

# Image refs. LLM_REGISTRY is the prefix before "llm-toolkit", e.g.
# "ghcr.io/you/" (trailing slash). Empty means local tags. LLM_IMAGE overrides
# the harness image entirely.
REGISTRY="${LLM_REGISTRY:-}"
img() { printf '%s' "${REGISTRY}llm-toolkit:$1"; }

WORKDIR="${WORKDIR:-$REPO_ROOT}"
LLM_SESSION_KEYS="${LLM_SESSION_KEYS:-1}"
export LLM_STATE_DIR="$STATE_DIR"

die() { echo "llm: $*" >&2; exit 1; }

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- harness + args -----------------------------------------------------------
HARNESS="${1:-}"
[ -n "$HARNESS" ] || usage 1
shift

if [ "$HARNESS" = "run" ]; then
  HARNESS=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness) HARNESS="${2:?--harness needs a value}"; shift 2 ;;
      --model)   MODEL="${2:?--model needs a value}"; shift 2 ;;
      *) break ;;
    esac
  done
  [ -n "$HARNESS" ] || die "run: --harness is required"
fi

# Append a pattern to the repo's .gitignore unless it's already covered (either
# as an exact line or by an existing pattern). Keeps runtime state out of git so
# harness snapshots don't recurse into it.
ensure_ignored() {
  local entry="$1" gi="$REPO_ROOT/.gitignore" probe
  probe="${entry#/}"; probe="${probe%/}"
  [ -f "$gi" ] || : > "$gi"
  grep -qxF "$entry" "$gi" 2>/dev/null && return 0
  [ -n "$probe" ] && git -C "$REPO_ROOT" check-ignore -q -- "$probe" 2>/dev/null && return 0
  printf '%s\n' "$entry" >> "$gi"
  echo "added $entry to .gitignore"
}

# `llm init` scaffolds a repo: the .llm-toolkit/ template, the llm-toolkit
# block in the repo's root .env (created, or appended if the block is missing),
# and the .gitignore entries that keep runtime state out of git.
if [ "$HARNESS" = "init" ]; then
  mkdir -p "$STATE_DIR/data"

  ENV_FILE="$REPO_ROOT/.env"
  BLOCK="$TEMPLATE/.env.example"
  if [ -f "$ENV_FILE" ]; then
    if grep -qF '# --- llm-toolkit ---' "$ENV_FILE"; then
      echo "kept llm-toolkit settings in $ENV_FILE"
    else
      printf '\n' >> "$ENV_FILE"
      cat "$BLOCK" >> "$ENV_FILE"
      echo "appended llm-toolkit settings to $ENV_FILE"
    fi
  else
    cp "$BLOCK" "$ENV_FILE"
    echo "created $ENV_FILE"
  fi

  for f in "$TEMPLATE"/*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    dest="$STATE_DIR/$base"
    if [ ! -e "$dest" ]; then
      cp -R "$f" "$dest"
      echo "added .llm-toolkit/$base"
    fi
  done

  echo "state dir: $STATE_DIR"
  ensure_ignored ".env"
  if [ "$STATE_DIR" = "$REPO_ROOT" ]; then
    ensure_ignored "/data/"
  else
    ensure_ignored "${STATE_DIR#"$REPO_ROOT"/}/data/"
  fi
  exit 0
fi

# `llm config` re-seeds this project's config from the template defaults.
if [ "$HARNESS" = "config" ]; then
  mkdir -p "$STATE_DIR/config"
  cp -R "$TEMPLATE/config/." "$STATE_DIR/config/"
  echo "copied default config to $STATE_DIR/config (edit to override)"
  exit 0
fi

case "$HARNESS" in
  opencode|pi|shell) ;;
  -h|--help|help) usage 0 ;;
  *) die "unknown harness: $HARNESS (expected 'opencode', 'pi', or 'shell')" ;;
esac

[ -d "$WORKDIR" ] || die "WORKDIR does not exist: $WORKDIR"

# opencode snapshots the workspace with git. If the harness data dir lives inside
# the workspace and isn't gitignored, each snapshot re-hashes the previous one —
# runaway CPU and disk. Warn before launching (repos created before `llm init`
# learned to write .gitignore).
if [ "$HARNESS" = "opencode" ] && command -v git >/dev/null 2>&1 \
   && git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1; then
  case "$STATE_DIR/data" in
    "$WORKDIR"/*)
      data_rel="${STATE_DIR#"$WORKDIR"/}/data"
      if ! git -C "$WORKDIR" check-ignore -q -- "$data_rel" 2>/dev/null; then
        echo "llm: warning: $data_rel is inside the workspace and not gitignored." >&2
        echo "     opencode's git snapshots will include it (runaway CPU/disk)." >&2
        echo "     fix: echo '$data_rel/' >> \"$WORKDIR/.gitignore\"" >&2
      fi ;;
  esac
fi

# Prepend the model if the caller asked for one and didn't pass it themselves.
MODEL="${MODEL:-}"
if [ -n "$MODEL" ] && [ "$HARNESS" != "shell" ]; then
  has_model=0
  for a in "$@"; do
    case "$a" in --model|-m|--model=*) has_model=1 ;; esac
  done
  [ "$has_model" = 1 ] || set -- --model "$MODEL" "$@"
fi

# --- provider key pre-flight --------------------------------------------------
# Fail fast rather than launching a container that can't authenticate. The
# provider is read from the harness config; unknown providers are not checked.
# Bypass with LLM_SKIP_KEY_CHECK=1 (e.g. when you authenticated another way).
if [ "$HARNESS" != "shell" ] && [ "${LLM_SKIP_KEY_CHECK:-0}" != "1" ]; then
  case "$HARNESS" in
    opencode) cfg="$CONFIG_OPENCODE/opencode.jsonc" ;;
    pi)       cfg="$CONFIG_PI/settings.json" ;;
    *)        cfg="" ;;
  esac
  provider=""
  if [ -n "$cfg" ] && [ -f "$cfg" ]; then
    provider="$(sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p; s/.*"defaultProvider"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" | head -1)"
    provider="${provider%%/*}"
  fi
  case "$provider" in
    openrouter)
      if [ -z "${OPENROUTER_MANAGEMENT_KEY:-}" ] && [ -z "${OPENROUTER_API_KEY:-}" ]; then
        prompt_key OPENROUTER_MANAGEMENT_KEY "OpenRouter management key (https://openrouter.ai/settings/management-keys)" \
          || prompt_key OPENROUTER_API_KEY "OpenRouter API key" \
          || die "no OpenRouter key: set OPENROUTER_MANAGEMENT_KEY or OPENROUTER_API_KEY in $STATE_DIR/.env or $GLOBAL_SETTINGS (bypass with LLM_SKIP_KEY_CHECK=1)"
      fi ;;
    deepseek)
      [ -n "${DEEPSEEK_API_KEY:-}" ] || prompt_key DEEPSEEK_API_KEY "DeepSeek API key" \
        || die "no DeepSeek key: set DEEPSEEK_API_KEY in $STATE_DIR/.env or $GLOBAL_SETTINGS (bypass with LLM_SKIP_KEY_CHECK=1)" ;;
    anthropic)
      [ -n "${ANTHROPIC_API_KEY:-}" ] || prompt_key ANTHROPIC_API_KEY "Anthropic API key" \
        || die "no Anthropic key: set ANTHROPIC_API_KEY in $STATE_DIR/.env or $GLOBAL_SETTINGS (bypass with LLM_SKIP_KEY_CHECK=1)" ;;
    openai)
      [ -n "${OPENAI_API_KEY:-}" ] || prompt_key OPENAI_API_KEY "OpenAI API key" \
        || die "no OpenAI key: set OPENAI_API_KEY in $STATE_DIR/.env or $GLOBAL_SETTINGS (bypass with LLM_SKIP_KEY_CHECK=1)" ;;
  esac
fi

# --- image --------------------------------------------------------------------
# Base toolchain, then the harness image, then an optional per-repo derived
# image. A repo Dockerfile picks its FROM via ARG HARNESS (default base):
#   ARG LLM_REGISTRY=
#   ARG HARNESS=base
#   FROM ${LLM_REGISTRY}llm-toolkit:${HARNESS}
SLUG="$(basename "$REPO_ROOT" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g')"
HOST_SHORT="$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g')"
[ -n "$HOST_SHORT" ] || HOST_SHORT="host"
HARNESS_FOR_IMAGE="$HARNESS"
[ "$HARNESS" = "shell" ] && HARNESS_FOR_IMAGE="base"

have() { docker image inspect "$1" >/dev/null 2>&1; }

# Pull the image if the registry is configured; otherwise (or on pull failure)
# build it from the toolkit's Dockerfile. $2 is the Dockerfile, $3.. are extra
# build args.
fetch() {
  local ref="$1" df="$2"; shift 2
  have "$ref" && return 0
  if [ -n "$REGISTRY" ]; then
    echo "llm: pulling $ref ..." >&2
    docker pull "$ref" && return 0
    echo "llm: pull failed; falling back to a local build" >&2
  fi
  [ -f "$df" ] || die "image $ref not present and no Dockerfile to build it"
  echo "llm: building $ref ..." >&2
  docker build -f "$df" -t "$ref" "$@" "$TOOLKIT_DIR" >&2
}

ensure_base() {
  fetch "$(img base)" "$TOOLKIT_DIR/images/base/Dockerfile"
}

ensure_node() {
  fetch "$(img node)" "$TOOLKIT_DIR/images/node/Dockerfile" \
    --build-arg "BASE_REF=$(img base)"
}

ensure_harness() {
  local h="$1"
  [ "$h" = "base" ] && { ensure_base; return 0; }
  fetch "$(img "$h")" "$TOOLKIT_DIR/images/${h}/Dockerfile" \
    --build-arg "NODE_REF=$(img node)"
}

if [ -n "${LLM_IMAGE:-}" ]; then
  IMAGE="$LLM_IMAGE"
elif [ -f "$STATE_DIR/image/Dockerfile" ] || [ -f "$STATE_DIR/Dockerfile" ]; then
  if [ -f "$STATE_DIR/image/Dockerfile" ]; then
    DOCKERFILE="$STATE_DIR/image/Dockerfile"
  else
    DOCKERFILE="$STATE_DIR/Dockerfile"
  fi
  BUILD_CONTEXT="$REPO_ROOT"
  IMAGE="llm-toolkit:repo-${SLUG}-${HARNESS_FOR_IMAGE}"
  ensure_harness "$HARNESS_FOR_IMAGE"
  if ! have "$IMAGE"; then
    echo "llm: building $IMAGE from $DOCKERFILE ..." >&2
    docker build -f "$DOCKERFILE" \
      --build-arg "LLM_REGISTRY=$REGISTRY" --build-arg "HARNESS=$HARNESS_FOR_IMAGE" \
      -t "$IMAGE" "$BUILD_CONTEXT" >&2
  fi
else
  IMAGE="$(img "$HARNESS_FOR_IMAGE")"
  ensure_harness "$HARNESS_FOR_IMAGE"
fi

# --- OpenRouter key: one per project+harness, reused across sessions ----------
# The key secret is cached globally (~/.llm-toolkit/keys.json, 0600).
KEY_HASH=""
KEY_LABEL=""
SESSION_KEY=""

if [ "$HARNESS" != "shell" ] && [ "$LLM_SESSION_KEYS" != "0" ] && [ -n "${OPENROUTER_MANAGEMENT_KEY:-}" ]; then
  KEY_LABEL="llm-toolkit/${HOST_SHORT}/${SLUG}/${HARNESS}"
  KEY_CACHE="$GLOBAL_DIR/keys.json"
  mkdir -p "$GLOBAL_DIR"; chmod 700 "$GLOBAL_DIR" 2>/dev/null || true

  if [ -f "$KEY_CACHE" ]; then
    SESSION_KEY="$(jq -r --arg n "$KEY_LABEL" '.[$n].key // empty' "$KEY_CACHE" 2>/dev/null || true)"
    KEY_HASH="$(jq -r --arg n "$KEY_LABEL" '.[$n].hash // empty' "$KEY_CACHE" 2>/dev/null || true)"
  fi

  if [ -z "$SESSION_KEY" ]; then
    # Cache miss: drop any key already using this name so we keep exactly one.
    stale="$("$TOOLKIT_DIR/bin/or-key" list 2>/dev/null | jq -r --arg n "$KEY_LABEL" '(if type=="object" then .data else . end)[]? | select(.name==$n) | .hash' 2>/dev/null || true)"
    while IFS= read -r h; do [ -n "$h" ] && "$TOOLKIT_DIR/bin/or-key" delete "$h" >/dev/null 2>&1 || true; done <<<"$stale"

    create_args=(--name "$KEY_LABEL")
    [ -n "${SESSION_LIMIT:-}" ] && create_args+=(--limit "$SESSION_LIMIT")
    if resp="$("$TOOLKIT_DIR/bin/or-key" create "${create_args[@]}" 2>/dev/null)"; then
      SESSION_KEY="$(jq -r '.key // .data.key' <<<"$resp")"
      KEY_HASH="$(jq -r '.data.hash // .hash // empty' <<<"$resp")"
      tmp="$KEY_CACHE.tmp.$$"
      if [ -f "$KEY_CACHE" ]; then
        jq --arg n "$KEY_LABEL" --arg k "$SESSION_KEY" --arg h "$KEY_HASH" '.[$n]={key:$k,hash:$h}' "$KEY_CACHE" > "$tmp"
      else
        jq -n --arg n "$KEY_LABEL" --arg k "$SESSION_KEY" --arg h "$KEY_HASH" '{($n):{key:$k,hash:$h}}' > "$tmp"
      fi
      mv "$tmp" "$KEY_CACHE"; chmod 600 "$KEY_CACHE" 2>/dev/null || true
    else
      echo "llm: warning: could not create OpenRouter key; falling back to OPENROUTER_API_KEY" >&2
    fi
  fi

  if [ -n "$SESSION_KEY" ]; then
    OPENROUTER_API_KEY="$SESSION_KEY"; export OPENROUTER_API_KEY
    if [ -n "$KEY_HASH" ] && [ -n "${SESSION_LIMIT:-}" ]; then
      key_json="$("$TOOLKIT_DIR/bin/or-key" get "$KEY_HASH" 2>/dev/null || true)"
      # Keep the key's credit limit in sync with SESSION_LIMIT.
      cur_limit="$(jq -r '.limit // empty' <<<"$key_json" 2>/dev/null || true)"
      [ "$cur_limit" = "$SESSION_LIMIT" ] \
        || "$TOOLKIT_DIR/bin/or-key" update "$KEY_HASH" --limit "$SESSION_LIMIT" >/dev/null 2>&1 || true
    fi
  fi
fi

# --- docker mounts ------------------------------------------------------------
mounts=(
  -v "$WORKDIR:/workspace"
  -v "$CONFIG_OPENCODE:/opt/opencode-config:ro"
  -v "$STATE_DIR/data/opencode:/root/.local/share/opencode"
  -v "$CONFIG_PI:/opt/pi-config:ro"
  -v "$STATE_DIR/data/pi/agent:/root/.pi/agent"
)
[ -d "$HOME/.ssh" ] && mounts+=(-v "$HOME/.ssh:/root/.ssh-host:ro")
[ -f "$HOME/.gitconfig" ] && mounts+=(-v "$HOME/.gitconfig:/etc/gitconfig:ro")

# Per-repo extra mounts. One "host:container[:opts]" per line; '#' comments and
# blank lines ignored; a leading ~ on either side expands to the host $HOME.
# Lives in image/ (falling back to the .llm-toolkit/ root for older repos).
MOUNTS_FILE="$STATE_DIR/image/mounts"
[ -f "$MOUNTS_FILE" ] || MOUNTS_FILE="$STATE_DIR/mounts"
if [ -f "$MOUNTS_FILE" ]; then
  while IFS= read -r m || [ -n "$m" ]; do
    m="${m%%$'\r'}"
    case "$m" in ''|\#*) continue ;; esac
    # Split host:container[:opts]. A leading ~ on either side expands to the host
    # $HOME, so "~/Desktop:~/Desktop" mounts the host dir at the same absolute
    # path inside the container — host paths (e.g. dragged files) then resolve.
    host="${m%%:*}"
    cpath=""
    opts=""
    if [ "$host" != "$m" ]; then
      rest="${m#*:}"
      if [ "$rest" != "${rest%%:*}" ]; then
        cpath="${rest%:*}"
        opts=":${rest##*:}"
      else
        cpath="$rest"
      fi
    fi
    host="${host/#\~/$HOME}"
    cpath="${cpath/#\~/$HOME}"
    case "$host" in /*) ;; *) case "$host" in "") ;; *) host="$REPO_ROOT/$host" ;; esac ;; esac
    if [ -n "$cpath" ]; then m="$host:$cpath$opts"; else m="$host"; fi
    mounts+=(-v "$m")
  done < "$MOUNTS_FILE"
fi

# Per-repo on-start hook, run inside the container before the harness.
ON_START="$STATE_DIR/image/on-start.sh"
[ -f "$ON_START" ] || ON_START="$STATE_DIR/on-start.sh"
[ -f "$ON_START" ] && mounts+=(-v "$ON_START:/opt/llm-toolkit/on-start.sh:ro")

# Forward the host SSH agent. On macOS, Docker Desktop/OrbStack intercept the
# magic path /run/host-services/ssh-auth.sock (it need not exist on the host); on
# Linux, mount the real SSH_AUTH_SOCK.
AGENT_SOCK=""
if [ "$(uname -s)" = "Darwin" ]; then
  AGENT_SOCK=/run/host-services/ssh-auth.sock
elif [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
  AGENT_SOCK="$SSH_AUTH_SOCK"
fi
env_args=(-e "TERM=${TERM:-xterm-256color}" -e "XDG_DATA_HOME=/root/.local/share")
if [ -n "$AGENT_SOCK" ]; then
  mounts+=(-v "$AGENT_SOCK:/agent.sock")
  env_args+=(-e "SSH_AUTH_SOCK=/agent.sock")
fi
[ -n "${OPENROUTER_API_KEY:-}" ] && env_args+=(-e "OPENROUTER_API_KEY=$OPENROUTER_API_KEY")
[ -n "${DEEPSEEK_API_KEY:-}" ] && env_args+=(-e "DEEPSEEK_API_KEY=$DEEPSEEK_API_KEY")

# Forward extra env vars named in image/env (one NAME per line), if set. Use for
# per-repo credentials the container needs (e.g. GH_TOKEN).
ENV_FILE="$STATE_DIR/image/env"
[ -f "$ENV_FILE" ] || ENV_FILE="$STATE_DIR/env"
if [ -f "$ENV_FILE" ]; then
  while IFS= read -r name || [ -n "$name" ]; do
    name="${name%%$'\r'}"
    case "$name" in ''|\#*) continue ;; esac
    case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
    printenv "$name" >/dev/null 2>&1 && env_args+=(-e "$name=$(printenv "$name")")
  done < "$ENV_FILE"
fi

# --- run ----------------------------------------------------------------------
tty_args=(-i)
[ -t 0 ] && tty_args=(-it)

cmd_args=("$HARNESS" "$@")
if [ "$HARNESS" = "shell" ]; then
  cmd_args=(bash "$@")
fi

set +e
docker run --rm --init "${tty_args[@]}" --workdir /workspace \
  "${env_args[@]}" "${mounts[@]}" "$IMAGE" "${cmd_args[@]}"
exit_code=$?
set -e

exit "$exit_code"
